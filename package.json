{
  "name": "prisma-adapter-bun-sqlite-benchmark",
  "version": "0.1.0",
  "description": "Comprehensive benchmark comparing Prisma SQLite adapters under Bun",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "generate": "bunx --bun prisma generate",
    "start": "bun run src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "prisma": "^7.0.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@prisma/adapter-libsql": "^7.0.0",
    "@synapsenwerkstatt/prisma-bun-sqlite-adapter": "^1.2.2",
    "prisma-adapter-bun-sqlite": "^0.5.6"
  }
}
